rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAdmin() { return request.auth != null && request.auth.token.email == "darabinafise@gmail.com"; }
    match /artworks/{id} {
      allow read: if resource.data.published == true || signedInAdmin();
      allow create, update, delete: if signedInAdmin();
    }
    match /categories/{id} {
      allow read: if resource.data.active != false || signedInAdmin();
      allow create, update, delete: if signedInAdmin();
    }
    match /siteSettings/{id} {
      allow read: if true;
      allow create, update, delete: if signedInAdmin();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
