rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedInAdmin() { return request.auth != null && request.auth.token.email == "admin@example.com"; }
    match /artworks/{artworkId}/{fileName} {
      allow read: if true;
      allow create, update: if signedInAdmin() && request.resource.size < 8 * 1024 * 1024 && request.resource.contentType.matches('image/(jpeg|png|webp|avif)');
      allow delete: if signedInAdmin();
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
